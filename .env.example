# Copy to .env and fill in. Missing keys => offline/mock mode (tests and eval still run).
# Never commit .env (it is in .gitignore).
# Keep comments on their own line: python-dotenv reads "KEY=   # note" as the value "# note".

# --- AI provider (DECISIONS.md D1, D2, section 1a) ---
# One OpenAI key covers the assistant (A) and image generation (B).
# No key => A uses the rule router + templates, B uses the committed cache + placeholder.
OPENAI_API_KEY=

# --- Assignment A: assistant LLM ---
# openai | rules   (rules = offline fallback, no key needed)
LLM_PROVIDER=openai
# chat model for router + phraser (eval: assignment-a/evals/results/eval_report_openai.md)
OPENAI_MODEL=gpt-5.4-mini
# none | low | medium  (gpt-5.4-mini rejects "minimal"; "none" is fastest)
OPENAI_REASONING_EFFORT=none
# per-call timeout; on timeout the assistant falls back to rules/templates
OPENAI_TIMEOUT_S=20
# total budget for one question (all provider calls); past it the rules/templates answer
ASSISTANT_BUDGET_S=8

# --- Assignment B: image generation ---
# openai | offline | failing | fixture
# No key (or an unusable one) => offline: serves the committed images in assignment-b/cache/
# and the procedural placeholder for anything else, so a run without keys still shows images.
IMAGE_PROVIDER=openai
# blank => swatch/config.yaml -> image.default_model (gpt-image-1-mini)
OPENAI_IMAGE_MODEL=
# low | medium | high  (speed/cost tier used in LATENCY_NOTE)
IMAGE_QUALITY=low
# per-image timeout; on timeout the pipeline draws the placeholder (generation takes 9-17 s)
OPENAI_IMAGE_TIMEOUT_S=30
SWATCH_CACHE_DIR=assignment-b/cache
# set 1 to force the image-generation fallback path
SIMULATE_IMAGE_FAILURE=0

# --- Assignment B: Ravelry reference photos ---
# Ravelry offers two credential styles (ravelry.com/pro -> your app -> credentials).
# Read-only Basic Auth is used for server-side pattern search (DECISIONS.md D7).
# OAuth 2.0 fields are kept for the app already registered; see DECISIONS.md -> Ravelry auth.
# basic | oauth2
RAVELRY_AUTH=basic
# basic auth: read-only username and password
RAVELRY_USERNAME=
RAVELRY_PASSWORD=
# oauth2: token obtained once via the authorisation flow (the only oauth2 value the code reads)
RAVELRY_ACCESS_TOKEN=
# reserved: the app registration's client credentials. Nothing in this repo reads them;
# they are here because obtaining RAVELRY_ACCESS_TOKEN needs them.
RAVELRY_CLIENT_ID=
RAVELRY_CLIENT_SECRET=
# search timeout; blank => config.yaml -> ravelry.search_timeout_s (5). Any failure => no reference photo
RAVELRY_TIMEOUT_S=5
